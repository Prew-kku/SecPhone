# SecondPhone Store — ตัวอย่างตัวแปรสภาพแวดล้อม
# คัดลอกเป็น .env แล้วตั้งค่าจริง: cp .env.example .env
# ห้าม commit ไฟล์ .env (มีใน .gitignore แล้ว)

# ---------- Runtime ----------
NODE_ENV="production"

# ---------- Public base URL ----------
# SITE_URL: URL สาธารณะแบบเต็ม ใช้ทำ canonical URL, Open Graph, sitemap.xml, robots.txt, JSON-LD
# - local:            http://localhost:3000
# - Railway:          https://<your-app>.up.railway.app  (ต้องมี https:// นำหน้า)
# - custom domain:    https://yourdomain.com
# ถ้าเว้นว่าง ระบบจะใช้ค่า RAILWAY_PUBLIC_DOMAIN ที่ Railway ใส่ให้อัตโนมัติ (เติม https:// ให้)
# ถ้าไม่มีทั้งคู่ จะ fallback เป็น http://localhost:3000
SITE_URL="http://localhost:3000"

# ---------- Database ----------
# Path A (docker compose): host คือชื่อ service "db"
DATABASE_URL="postgresql://sp_user:change-me-strong-password@db:5432/secondphone?schema=public"
# Path B (local Postgres): เปลี่ยน host เป็น localhost
# DATABASE_URL="postgresql://sp_user:sp_pass@localhost:5432/secondphone?schema=public"
# Path C (Railway): คัดลอกมาจาก service PostgreSQL → Variables → DATABASE_URL
#   ต้องมี ?sslmode=require ต่อท้ายเมื่อต่อจากภายนอก Railway
# DATABASE_URL="postgresql://postgres:<password>@<host>.railway.app:5432/railway?sslmode=require"

# ใช้โดย service "db" ของ docker compose — ค่า POSTGRES_* ต้องสอดคล้องกับ DATABASE_URL
# (ไม่ต้องตั้งบน Railway เพราะใช้ PostgreSQL เป็น service แยก)
POSTGRES_USER="sp_user"
POSTGRES_PASSWORD="change-me-strong-password"
POSTGRES_DB="secondphone"

# ---------- Contact channels (แสดงบนเว็บ; ค่าว่าง = ไม่แสดงช่องทางนั้น) ----------
# อ่านที่ runtime ฝั่ง server จึงแก้ค่าแล้วไม่ต้อง rebuild image
# (ชื่อ NEXT_PUBLIC_* แบบเดิมยังใช้ได้เป็น fallback แต่จะถูก inline ตอน build)
# LINE_ID: LINE ID ของร้าน (ไม่ต้องใส่ @ นำหน้า)
LINE_ID=""
# FACEBOOK_URL: URL เพจ Facebook แบบเต็ม (https://...)
FACEBOOK_URL=""
# PHONE_NUMBER: เบอร์โทร เช่น 0812345678
PHONE_NUMBER=""
# ชื่อร้านที่แสดงบนเว็บ
SITE_NAME="SecondPhone Store"

# ---------- Demo mode ----------
# "true" (ค่าเริ่มต้น) = แสดงแบนเนอร์และข้อความกำกับว่าเนื้อหาเป็นข้อมูลสาธิต
# "false" = ปิดข้อความสาธิต ใช้เมื่อขึ้นระบบจริงกับข้อมูลที่ตรวจสอบแล้วเท่านั้น
DEMO_MODE="true"

# ---------- Admin auth (Phase 3) ----------
# สร้างด้วย: openssl rand -base64 48
JWT_SECRET=""
# อายุเซสชัน (ชั่วโมง)
SESSION_TTL_HOURS="8"
# ตั้ง "false" เฉพาะเมื่อทดสอบ production build บน HTTP ท้องถิ่น
# ค่าเริ่มต้นใน production คือ "true" — cookie จะถูกส่งแบบ Secure เท่านั้น
COOKIE_SECURE="false"

# ---------- Admin initialization (scripts/create-admin.ts) ----------
# ใช้ครั้งแรกเท่านั้น — ห้าม hardcode รหัสผ่านในโค้ดหรือ commit
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="ผู้ดูแลร้าน"

# ---------- Demo seed ----------
# "true" = รัน seed ใน entrypoint (ครั้งแรกเท่านั้น) แล้วตั้งกลับ "false"
RUN_SEED="false"
# "true" = ให้ seed สร้าง admin demo ด้วย (ใช้ ADMIN_EMAIL/ADMIN_PASSWORD)
SEED_DEMO_ADMIN="false"
# "true" = อนุญาตให้ seed เขียนทับข้อมูลเดิม (ค่าเริ่มต้นคือ create-only)
# ปล่อย "false" ไว้เสมอหลังรันครั้งแรก เพื่อไม่ทับราคา/สถานะที่แก้ผ่านหลังบ้าน
SEED_OVERWRITE="false"

# ---------- Image uploads ----------
# โฟลเดอร์เก็บรูปที่อัปโหลด (ผูกกับ volume ใน docker compose)
# ค่า "/app/uploads" เหมาะกับใน container; ถ้ารัน local ตรง ๆ ให้เว้นว่างเพื่อใช้ ./uploads
UPLOAD_DIR="/app/uploads"
MAX_UPLOAD_MB="8"
